# =============================================================================
# ASCLEPIO BROWSER AI CONFIGURATION (TEMPLATE)
# =============================================================================
# Copie este arquivo para .env e preencha suas chaves de API:

# 1. Google Gemini (Modelo Principal Recomendado: gemini-2.5-flash)
GOOGLE_API_KEY=sua_chave_gemini_aqui
DEFAULT_GEMINI_MODEL=gemini-2.5-flash

# 2. OpenAI API (Fallback Simultâneo 1)
OPENAI_API_KEY=sua_chave_openai_aqui
DEFAULT_OPENAI_MODEL=gpt-4o-mini

# 3. OpenRouter API (Fallback Simultâneo 2)
OPENROUTER_API_KEY=sua_chave_openrouter_aqui
DEFAULT_OPENROUTER_MODEL=openai/gpt-4o-mini

# 4. Antigravity Local Engine (Fallback Local Offline)
AGY_PATH=C:\Users\marlo\AppData\Local\agy\bin\agy.exe
